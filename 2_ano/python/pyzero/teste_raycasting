#para setar teclas (usar a partir de on_key_*()):
'''
keyboard.w  --> A tecla 'W'
keyboard.a  --> A tecla 'A'
keyboard.s  --> A tecla 'S'
keyboard.d  --> A tecla 'D'
keyboard.lshift  --> A tecla shift esquerda !!pode ser "suprimida" em um evento on_rey_*!!
keyboard.ctrl  --> A tecla 'ctrl'
keyboard.e --> A tecla 'E'
OBS: 
keyboard.kp0  # A tecla '0' no teclado numérico
keyboard.k_0  # A tecla principal '0'
'''
def draw():
    screen.clear()
    screen.fill('lightblue')
    player.draw()

def update():
    if keyboard.w:
        player.y -= 1
        player.angle += math.cos(player.angle) * 0.5
    if keyboard.s:
        player.y += 1
        player.angle -= math.sin(player.angle) * 0.5
    if keyboard.d:
        player.x += 1
    if keyboard.a:
        player.x -= 1
    
pgzrun.go()
