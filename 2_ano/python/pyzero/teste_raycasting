def draw():
    screen.clear()
    screen.fill('lightblue')
    #Acessar cada linha por coluna para rendenizar as paredes:
    for r in range(len(map)):
        for c in range(len(map[0])):
            #encontrar as coordenadas do tile
            tile_x = c * TILE_SIZE #loop colunas
            tile_y = r * TILE_SIZE #loop linhas
            #verificar se é 0 ou 1:
            if map[r][c] == 1:
                TILE.topleft = tile_x, tile_y #Lembrar de definir a posição!!!
                screen.draw.filled_rect(TILE, RED) #desenhar o tile para teste
            elif map[r][c] == 0:
                TILE.topleft = tile_x, tile_y
                screen.draw.rect(TILE, WHITE) #desenhar o tile para teste
    
    player.draw()

def update():
    if keyboard.w:
        player.y -= 1
        player.angle += math.sin(player.angle) * 0.5
    if keyboard.s:
        player.y += 1
        player.angle -= math.sin(player.angle) * 0.5
    if keyboard.d:
        player.x += 1
        player.angle += math.cos(player.angle) * 0.5
    if keyboard.a:
        player.x -= 1
        player.angle -= math.cos(player.angle) * 0.5
