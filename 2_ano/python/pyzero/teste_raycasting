    # xa = ya / math.tan(player.angle+1)
    # colisao_horizontal_x = player.x + (colisao_horizontal_y - player.y) / math.tan(player.angle+1)
    
    #Para não procurar paredes infinitamente, as colisões encontradas x e y são barradas pelo tamaanho da janela:
    if  player.x <= WIDTH and player.x >= 0 and player.y <= HEIGHT and player.y >= 0:
        #checar se existe uma parede, senão continuar a incrementação:
        for y in range(int(cima), int(baixo), 1):
            for x in range(int(esquerda), int(direita), 1):
                if map[y][x] == 1:
                    colidiu = True
                    break
    if not colidiu:
        player.x = posicao_playerx
        player.y = posicao_playery
    
    end = (player.x + math.cos(player.angle)*200, player.y + math.sin(player.angle)*200) #update para que o "fim" do vetor aponte para onde o jogador está 'olhando'

