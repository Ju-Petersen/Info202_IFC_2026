def has_wall(x, y):
    col = int(x // TILE_SIZE)
    row = int(y // TILE_SIZE)

    if row < 0 or row >= ROWS:
        return 1
    if col < 0 or col >= COLS:
        return 1

    return map[row][col]

wall_x = 0
wall_y = 0

def draw():
    global ray_end_x, ray_end_y, wall_x, wall_y
    screen.clear()
    screen.fill('lightblue')
    #acessar cada linha por coluna para rendenizar as paredes 
    for r in range(len(map)):
        for c in range(len(map[0])):
            #encontrar as coordenadas do tile
            tile_x = c * TILE_SIZE - 1 #loop colunas
            tile_y = r * TILE_SIZE - 1 #loop linhas
            #verificar se é 0 ou 1:
            if map[r][c] == 1:
                TILE.topleft = (tile_x - camera_x), (tile_y - camera_y) #Lembrar de definir a posição!!!
                screen.draw.filled_rect(TILE, BLUE) #desenhar o tile para teste
            elif map[r][c] == 0:
                TILE.topleft = (tile_x - camera_x), (tile_y - camera_y) #tyle_y = r * TILE_SIZE - 1 e tyle_x = c * TILE_SIZE - 1
                screen.draw.rect(TILE, WHITE) #desenhar o tile para teste
    
    player_screen = Actor('circulo.png', (player.x - camera_x, player.y - camera_y), (player.width, player.height))
    player_screen.draw()
