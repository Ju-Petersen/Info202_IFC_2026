def update():
    global end, parede_x, parede_y
    if keyboard.w:
        player.y += math.sin(player.angle) #anda em x ou y de acordo com a direção que o player "olha"
        player.x += math.cos(player.angle)
    if keyboard.s:
        player.y -= math.sin(player.angle)
        player.x -= math.cos(player.angle)
    if keyboard.d:
        player.angle += math.pi/180 #atualização do ângulo (vetor) qual "aponta" para a direção que o player olha
    if keyboard.a:
        player.angle -= math.pi/180
    end = (player.x + math.cos(player.angle)*50, player.y + math.sin(player.angle)*50) #update para que o "fim" do vetor aponte para onde o jogador está 'olhando'
    
    olhar_baixo = player.angle > 0 and player.angle < math.pi
    olhar_cima = not olhar_baixo
    olhar_direita = player.angle < 0.5*math.pi or player.angle > 1.5*math.pi
    olhar_esquerda = not olhar_direita
    
    #(explicação do tutorial sobre os pontos de colisão x e y da parede)
    if olhar_cima:
        colisao_horizontal_y = (player.y // TILE_SIZE) * TILE_SIZE - 1
    elif olhar_baixo:
        colisao_horizontal_y = (player.y // TILE_SIZE) * TILE_SIZE + TILE_SIZE
    if olhar_cima:
        ya = -TILE_SIZE
    if olhar_baixo:
        ya = TILE_SIZE
    xa = ya / math.tan(player.angle+1)
    colisao_horizontal_x = player.x + (colisao_horizontal_y - player.y) / math.tan(player.angle+1)
    
    #Para não procurar paredes infinitamente, as colisões encontradas x e y são barradas pelo tamaanho da janela:
    while colisao_horizontal_x <= WIDTH and colisao_horizontal_x >= 0 and colisao_horizontal_y <= WIDTH and colisao_horizontal_y >= 0:
        #checar se existe uma parede, senão continuar a incrementação:
        if map == ter_parede(colisao_horizontal_x, colisao_horizontal_y):
            encontrar_colisao = True
            parede_x = colisao_horizontal_x
            parede_y = colisao_horizontal_y
            break
        else:
            colisao_horizontal_x += xa
            colisao_horizontal_y += ya
    
    end_2 = colisao_horizontal_x, colisao_horizontal_y
    
