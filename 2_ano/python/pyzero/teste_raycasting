def update():
    global end, parede_x, parede_y
    dx = player.width / 2
    dy = player.height / 2
    posicao_playerx = player.x # posição futura
    posicao_playery = player.y # posição futura
    if keyboard.w:
        posicao_playery += math.sin(player.angle) #anda em x ou y de acordo com a direção que o player "olha"
        posicao_playerx += math.cos(player.angle)
    if keyboard.s:
        posicao_playery -= math.sin(player.angle)
        posicao_playerx -= math.cos(player.angle)
    if keyboard.d:
        player.angle += math.pi/180 #atualização do ângulo (vetor) qual "aponta" para a direção que o player olha
    if keyboard.a:
        player.angle -= math.pi/180
    
    cima = (posicao_playery-dx) // TILE_SIZE
    baixo = (posicao_playery+dx) // TILE_SIZE
    esquerda = (posicao_playerx-dy) // TILE_SIZE
    direita = (posicao_playerx+dy) // TILE_SIZE
    colidiu = False
    # calcula as posições x1, x2, y1, y2
    x1 = posicao_playerx - dx
    x2 = posicao_playerx + dx
    y1 = posicao_playery - dy
    y2 =posicao_playery + dy
    
    # verifica se os pontos estão "dentro" da parede
    c1 = ter_parede(x1, y1)
    c2 = ter_parede(x2,y1)
    c3 = ter_parede(x2,y2)
    c4 = ter_parede(x1,y2)
    
    # se nenhum ponto estiver dentro da parede
    if not (c1 or c2 or c3 or c4):
        # movimenta o jogador
        player.x = x1
        player.y = y1
    if not colidiu:
        player.x = posicao_playerx
        player.y = posicao_playery
    #     if cima:
    #         colisao_horizontal_y = (player.y // TILE_SIZE) * TILE_SIZE - 1
    #     elif baixo:
    #         colisao_horizontal_y = (player.y // TILE_SIZE) * TILE_SIZE + TILE_SIZE
